local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- =========================================================================
-- CONFIGURAÇÃO DO BANCO DE DADOS PÚBLICO (KVESTOR API)
-- =========================================================================
local BANCO_ID = "guhub_datastore_v2_4idudd"
local API_URL = "https://implying.cc" .. BANCO_ID .. "/"

-- Função para checar se o jogador está banido no banco público
local function verificarBanimento(username)
    local sucesso, resultado = pcall(function()
        return game:HttpGet(API_URL .. string.lower(username))
    end)
    if sucesso and resultado and resultado == "banido" then
        return true
    end
    return false
end

-- Função para BANIR o jogador (Envia para o Banco Público)
local function enviarBanimento(username)
    pcall(function()
        local url = API_URL .. string.lower(username)
        local dados = "banido"
        if syn then syn.request({Url = url, Method = "POST", Body = dados})
        elseif fluxus then fluxus.request({Url = url, Method = "POST", Body = dados})
        else request({Url = url, Method = "POST", Body = dados}) end
    end)
end

-- Função para LIBERAR o jogador (Remove do Banco Público)
local function removerBanimento(username)
    pcall(function()
        local url = API_URL .. string.lower(username)
        local dados = "livre"
        if syn then syn.request({Url = url, Method = "POST", Body = dados})
        elseif fluxus then fluxus.request({Url = url, Method = "POST", Body = dados})
        else request({Url = url, Method = "POST", Body = dados}) end
    end)
end

