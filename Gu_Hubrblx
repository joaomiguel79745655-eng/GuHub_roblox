local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- =========================================================================
-- CONFIGURAÇÃO DO BANCO DE DADOS PÚBLICO (KVESTOR API)
-- =========================================================================
local BANCO_ID = "guhub_datastore_v2_4idudd"
local API_URL = "https://implying.cc" .. BANCO_ID .. "/" -- FIX: Barra adicionada

-- Função para checar se o jogador está banido no banco público
local function verificarBanimento(username)
    local sucesso, resultado = pcall(function()
        return game:HttpGet(API_URL .. string.lower(username))
    end)
    if sucesso and resultado and string.find(string.lower(resultado), "banido") then
        return true
    end
    return false
end

-- Função genérica para requisições HTTP (Adaptada nativamente para o Delta Executor)
local function enviarRequisicao(url, dados)
    pcall(function()
        local requestFunc = syn and syn.request or fluxus and fluxus.request or request or http_request
        if requestFunc then
            requestFunc({
                Url = url,
                Method = "POST",
                Headers = {["Content-Type"] = "text/plain"},
                Body = dados
            })
        end
    end)
end

-- Função para BANIR o jogador (Envia para o Banco Público)
local function enviarBanimento(username)
    enviarRequisicao(API_URL .. string.lower(username), "banido")
end

-- Function para LIBERAR o jogador (Remove do Banco Público)
local function removerBanimento(username)
    enviarRequisicao(API_URL .. string.lower(username), "livre")
end

-- =========================================================================
-- CHECAGEM INDIVIDUAL DO JOGADOR (TELA PRETA)
-- =========================================================================
if LocalPlayer.Name ~= "4idudd" and verificarBanimento(LocalPlayer.Name) then
    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    local BlackFrame = Instance.new("Frame", ScreenGui)
    BlackFrame.Size = UDim2.new(1, 0, 1, 0)
    BlackFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    
    local TextLabel = Instance.new("TextLabel", BlackFrame)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "❌ GuHub: Seu acesso foi bloqueado pelo Dono!"
    TextLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    TextLabel.TextSize = 22
    return 
end

-- =========================================================================
-- INTERFACE INTERNA DO JOGO (ORION LIB CORRIGIDA)
-- =========================================================================
-- FIX: Link Raw completo da biblioteca OrionLib para Roblox
local OrionLib = loadstring(game:HttpGet(('https://githubusercontent.com')))()
local palavrasEngracadas = {"batata123", "senhaSegura99", "banidoAmanha", "capivaraDoMal"}

local Window = OrionLib:MakeWindow({Name = "GuHub 🚀", HidePremium = false, SaveConfig = false, IntroText = "Carregando GuHub..."})

local Tab = Window:MakeTab({Name = "Painel Hack", Icon = "rbxassetid://4483345998", PremiumOnly = false})
Tab:AddInput({
    Name = "Nome do Jogador:",
    Default = "",
    TextDisappear = false,
    Callback = function(textoDigitado)
        local username = string.gsub(textoDigitado, "^%s*(.-)%s*$", "%1")
        if username == "" then return end
        local sucesso, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
        if sucesso then
            local fotoUrl = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            local senhaAleatoria = palavrasEngracadas[math.random(1, #palavrasEngracadas)] .. math.random(100, 999)
            OrionLib:MakeNotification({Name = "Alvo: " .. username, Content = "Senha: " .. senhaAleatoria, Image = fotoUrl, Duration = 5})
        end
    end
})

-- Monitoramento em tempo real (Derruba se for travado durante a partida)
task.spawn(function()
    while task.wait(5) do
        if LocalPlayer.Name ~= "4idudd" and verificarBanimento(LocalPlayer.Name) then
            LocalPlayer:Kick("❌ Seu acesso ao GuHub foi revogado pelo Dono!")
        end
    end
end)

-- =========================================================================
-- PAINEL EXCLUSIVO DO DONO (Apenas para o nick: 4idudd)
-- =========================================================================
if LocalPlayer.Name == "4idudd" then
    local OwnerTab = Window:MakeTab({Name = "👑 Moderação (Dono)", Icon = "rbxassetid://4483345998", PremiumOnly = false})
    OwnerTab:AddLabel("Controle de Jogadores no Servidor:")

    -- Gerador dinâmico de botões para os alvos
    local function criarBotoesParaJogador(jogador)
        if jogador.Name == "4idudd" then return end
        
        OwnerTab:AddButton({
            Name = "🗑️ TRAVAR: " .. jogador.Name,
            Callback = function()
                enviarBanimento(jogador.Name)
                OrionLib:MakeNotification({
                    Name = "GuHub Admin",
                    Content = jogador.Name .. " foi bloqueado no banco de dados!",
                    Duration = 3
                })
            end
        })
        
        OwnerTab:AddButton({
            Name = "🔓 LIBERAR: " .. jogador.Name,
            Callback = function()
                removerBanimento(jogador.Name)
                OrionLib:MakeNotification({
                    Name = "GuHub Admin",
                    Content = jogador.Name .. " foi liberado do banco de dados!",
                    Duration = 3
                })
            end
        })
    end

    -- Cria botões para jogadores atuais
    for _, jogador in ipairs(Players:GetPlayers()) do
        criarBotoesParaJogador(jogador)
    end

    -- Monitora novos jogadores que entrarem
    Players.PlayerAdded:Connect(criarBotoesParaJogador)
end

